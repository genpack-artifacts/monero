#!/bin/sh
set -e

ARCH=$(uname -m)
if [ "$ARCH" != "x86_64" ]; then
    echo "Only x86_64 architecture is supported."
    exit 1
fi

LATEST_MONERO=$(curl -s https://api.github.com/repos/monero-project/monero/releases/latest|python -c "import json, sys; print(json.load(sys.stdin)['tag_name'])")

rm -rf /tmp/monero-*
download "https://downloads.getmonero.org/cli/monero-linux-x64-${LATEST_MONERO}.tar.bz2" | tar jxvf - -C /tmp

# Portage 外ソフトウェアなのでバージョンを /.genpack/ に記録する (owncloud, xmrig と同じ作法)。
# リリース tarball のトップレベルディレクトリ名 (monero-<arch>-linux-gnu-<ver>) がリリースバージョン。
set -- /tmp/monero-*
MONERO_DIR=$1
MONERO_VERSION=${MONERO_DIR##*/}
MONERO_VERSION=${MONERO_VERSION##*-}
MONERO_VERSION=${MONERO_VERSION#v}
echo "monero ${MONERO_VERSION}"

mv "$MONERO_DIR"/monerod "$MONERO_DIR"/monero-wallet-cli "$MONERO_DIR"/monero-blockchain-stats /usr/bin/
mkdir -p /.genpack
echo "$MONERO_VERSION" > /.genpack/monero-version
